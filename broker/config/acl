# 컨트롤러: 명령 발행 전용. 읽기 권한 없음
user central
topic write cmd/#

# 운영자 계정 — CLI 로 브로커 지표 조회만
user ops
topic read  $SYS/#

# 헬스체크 전용 — 토픽 하나만
user health
topic read  $SYS/broker/uptime

# Agent 공통 패턴 — %u 는 접속 username 으로 치환됨
# subscribe only. write 권한 없음
pattern read  cmd/%u/req
pattern read  cmd/broadcast/req
